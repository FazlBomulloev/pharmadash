BASIC_AUTH_USER=evolet
BASIC_AUTH_PASSWORD=

DOMAIN=evodash.duckdns.org

TZ=Europe/Moscow

EAPTEKA_REGION=spb
OZERKI_REGION=sankt-peterburg

# Вход в приложение. Первый аккаунт создаётся при старте, если в базе нет
# ни одного пользователя; существующего пользователя и его пароль не трогает.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true за https (обязательно на сервере). По http при true cookie не придёт.
COOKIE_SECURE=false
