# Скопируйте в .env и задайте свои значения: cp .env.example .env

# Логин и пароль для входа в приложение (basic-auth в nginx)
BASIC_AUTH_USER=evolet
BASIC_AUTH_PASSWORD=

# Порт на сервере, на котором открывается приложение
HTTP_PORT=80

# Часовой пояс: парсеры аптек запускаются ежедневно в 06:00 по этому времени
TZ=Europe/Moscow

# Регионы парсеров аптек
EAPTEKA_REGION=spb
OZERKI_REGION=sankt-peterburg
